# XolveManager — Supabase (cloud) configuration
# Copy to .env.local and fill in the values from the Supabase dashboard
# (Project Settings → API). NEVER commit .env.local and NEVER paste real
# keys into this example file.
#
# The app works without these values: it runs in offline mode and keeps all
# data in this browser (localStorage). Set them only when the Supabase
# project is ready.

# Public Supabase project URL, e.g. https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key from the Supabase dashboard (safe to expose in the browser;
# Row Level Security protects the data). Still, never commit the real key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google sign-in stays OFF until the Google provider is enabled in the
# Supabase dashboard AND this is set to true.
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
